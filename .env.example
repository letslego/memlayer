# Local defaults. These are placeholders, not production secrets.
HOST=127.0.0.1
PORT=43123

# SQLite file. Use ":memory:" only for tests.
DATABASE_PATH=./data/memlayer.sqlite

# Leave empty to use the embedded in-memory Redis-compatible store.
# Set to redis://127.0.0.1:6379 when running docker compose.
REDIS_URL=
REDIS_POOL_SIZE=4

# Comma-separated key:tenant pairs. The HTTP server maps the key to a tenant.
# Tenant id is never read from the JSON body or the model prompt.
API_KEYS=dev_acme_key:acme,dev_globex_key:globex

# L1 process cache in front of Redis. Short TTL bounds cross-process staleness.
L1_TTL_MS=500
L1_MAX=10000

WORKING_MEMORY_TTL_SEC=86400
WORKING_MEMORY_MAX_TURNS=40
PROFILE_TTL_SEC=604800
EMBEDDING_DIM=128
REQUEST_TIMEOUT_MS=2000
TOKEN_BUDGET=4096
# Google ADK chatbot (credentials stay outside source control)
GOOGLE_API_KEY=
ADK_MODEL=gemini-2.5-flash
MEMLAYER_TENANT=local
MEMLAYER_USER=user
MEMLAYER_SESSION=session-1
MEMLAYER_DB=data/adk.sqlite
# hash (offline) or gemini (remote, use a separate database when switching)
MEMLAYER_EMBEDDINGS=hash
